# CASEFILE Environment Configuration
# Copy this file to .env and fill in your values

# Database (SQLite local persistence; no server, host, port, or password)
CASEFILE_DATABASE_URL=sqlite:///./casefile.db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=org-your-openai-org-id
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# OpenTelemetry
OTEL_SERVICE_NAME=casefile
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14268/api/traces

# Application
CASEFILE_ENV=development
CASEFILE_LOG_LEVEL=DEBUG

# Human Approval
APPROVAL_TIMEOUT_HOURS=24
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=casefile@example.com

# Security
SECRET_KEY=your-secret-key-for-session-management

# External Microservice Providers (Phase 9)
POLICY_SERVICE_URL=http://policy-service.internal
POLICY_SERVICE_API_KEY=ext-policy-api-key-placeholder
CLAIMS_HISTORY_SERVICE_URL=http://claims-history.internal
CLAIMS_HISTORY_SERVICE_API_KEY=ext-history-api-key-placeholder
REPAIR_COST_SERVICE_URL=http://repair-cost.internal
REPAIR_COST_SERVICE_API_KEY=ext-repair-api-key-placeholder
FRAUD_SCORING_SERVICE_URL=http://fraud-scoring.internal
FRAUD_SCORING_SERVICE_API_KEY=ext-fraud-api-key-placeholder
DOCUMENT_STORAGE_SERVICE_URL=http://document-storage.internal
DOCUMENT_STORAGE_SERVICE_API_KEY=ext-docs-api-key-placeholder
