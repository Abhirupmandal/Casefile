# CASEFILE Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://casefile:${DB_PASSWORD}@localhost:5432/casefile_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=org-your-openai-org-id
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# OpenTelemetry
OTEL_SERVICE_NAME=casefile
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14268/api/traces

# Application
CASEFILE_ENV=development
CASEFILE_LOG_LEVEL=DEBUG

# Human Approval
APPROVAL_TIMEOUT_HOURS=24
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=casefile@example.com

# Security
SECRET_KEY=your-secret-key-for-session-management
